{
  "schemaVersion": 1,
  "slug": "pcf-copy-field",
  "name": "Copy Field",
  "tagline": "A text column with a copy-to-clipboard button and a confirmation.",
  "category": "utilities",
  "tags": [
    "clipboard",
    "accessibility",
    "read-only",
    "field"
  ],
  "control": {
    "namespace": "PCFHub",
    "constructor": "CopyField",
    "type": "field",
    "framework": "standard",
    "manifestPath": "CopyField/ControlManifest.Input.xml"
  },
  "links": {
    "homepage": "https://github.com/pcfhub/pcf-copy-field",
    "support": "https://github.com/pcfhub/pcf-copy-field/issues",
    "license": "MIT"
  },
  "docs": {
    "path": "docs"
  },
  "media": {
    "logo": "media/logo.png",
    "screenshots": [
      "media/at-rest.png",
      "media/copied.png"
    ]
  },
  "demo": {
    "fidelity": "full",
    "bundle": "out/controls/CopyField/bundle.js",
    "styles": [
      "out/controls/CopyField/css/CopyField.css"
    ],
    "presets": [
      {
        "slug": "default",
        "name": "Default",
        "description": "A reference number ready to copy. Press the button to see the confirmation.",
        "props": {
          "value": "PCFHUB-2026-0001",
          "placeholder": ""
        },
        "isDefault": true
      },
      {
        "slug": "empty",
        "name": "Nothing to copy",
        "description": "An empty column. The button is disabled, because a button that copies an empty string is a button that lies about having done something.",
        "props": {
          "value": "",
          "placeholder": "No reference yet"
        }
      },
      {
        "slug": "long-value",
        "name": "A long value",
        "description": "The field shrinks and the button holds its size, which is the layout a narrow canvas screen actually produces.",
        "props": {
          "value": "https://pcfhub.dev/components/pcf-copy-field?utm_source=example&utm_medium=demo",
          "placeholder": ""
        }
      }
    ]
  }
}
